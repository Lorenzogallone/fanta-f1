rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ========================================================================
     * Regole di sicurezza con Firebase Authentication
     * ======================================================================== */

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null &&
             request.auth.token.get('admin', false) == true;
    }

    /* ---------- Formazioni: campi e scadenze ----------
     * Un giocatore può scrivere solo i campi della propria formazione (non i
     * punti calcolati) ed entro la scadenza (qualifiche) + finestra "late" di
     * 10 minuti. Dopo la scadenza la formazione deve essere marcata come
     * ritardataria con la relativa penalità. 1 minuto di tolleranza per
     * differenze di orologio tra dispositivo e server.
     */
    function submissionChangedKeys() {
      return resource == null
        ? request.resource.data.keys().toSet()
        : request.resource.data.diff(resource.data).affectedKeys();
    }

    function withinDeadline(deadline, lateFlag, penaltyField) {
      return deadline != null
        && request.time < deadline + duration.value(11, 'm')
        && (request.time < deadline + duration.value(1, 'm')
            || (request.resource.data.get(lateFlag, false) == true
                && request.resource.data.get(penaltyField, 0) == -3));
    }

    function validOwnSubmission(raceId, userId) {
      let changed = submissionChangedKeys();
      let race = get(/databases/$(database)/documents/races/$(raceId)).data;
      return request.resource.data.get('userId', userId) == userId
        && changed.hasOnly(['userId', 'user', 'submittedAt', 'isLate', 'latePenalty',
                            'isLateSprint', 'latePenaltySprint',
                            'mainP1', 'mainP2', 'mainP3', 'mainJolly', 'mainJolly2',
                            'sprintP1', 'sprintP2', 'sprintP3', 'sprintJolly'])
        && (!changed.hasAny(['mainP1', 'mainP2', 'mainP3', 'mainJolly', 'mainJolly2'])
            || withinDeadline(race.get('qualiUTC', null), 'isLate', 'latePenalty'))
        && (!changed.hasAny(['sprintP1', 'sprintP2', 'sprintP3', 'sprintJolly'])
            || withinDeadline(race.get('qualiSprintUTC', null), 'isLateSprint', 'latePenaltySprint'))
        // a late penalty can be added by the player, never removed or changed
        && (!changed.hasAny(['isLate', 'latePenalty'])
            || (request.resource.data.get('isLate', false) == true
                && request.resource.data.get('latePenalty', 0) == -3))
        && (!changed.hasAny(['isLateSprint', 'latePenaltySprint'])
            || (request.resource.data.get('isLateSprint', false) == true
                && request.resource.data.get('latePenaltySprint', 0) == -3));
    }

    /* ===================== UTENTI (USERS) ================================
     * Collezione: /users/{userId}
     * Profilo utente con nickname, nome, cognome, email
     * ==================================================================== */
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    /* ===================== CLASSIFICA (RANKING) ==========================
     * Collezione: /ranking/{userId}
     * Dati di gioco: punti, jolly, formazioni campionato
     * ==================================================================== */
    match /ranking/{userId} {
      allow read: if isAuthenticated();
      // A new player starts from zero: points and jolly are assigned by the admin
      allow create: if isAdmin() || (isOwner(userId) && validNewRanking());
      // Players may only change their own non-score fields (punti, pointsByRace,
      // championshipPts are written only by the admin's points calculation)
      allow update: if isAdmin() || (isOwner(userId) && validOwnRankingUpdate());
      allow delete: if isAdmin();
    }

    function validNewRanking() {
      let d = request.resource.data;
      return d.get('puntiTotali', 0) == 0
        && d.get('jolly', 0) == 0
        && d.get('championshipPts', 0) == 0
        && d.get('pointsByRace', {}).size() == 0
        && d.get('usedLateSubmission', false) == false;
    }

    function validOwnRankingUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['name', 'photoURL', 'usedLateSubmission', 'jolly',
                              'jolly2Races', 'jollyRaceId',
                              'championshipPiloti', 'championshipCostruttori'])
        // the late submission can be used once: it can't be reset
        && (!changed.hasAny(['usedLateSubmission'])
            || request.resource.data.usedLateSubmission == true)
        // jolly: only through the double joker ledger (see validJollyChange)
        && (!changed.hasAny(['jolly', 'jolly2Races']) || validJollyChange());
    }

    /* Double joker ledger: ranking.jolly2Races = { raceId: true } for every
     * race where the player spent a jolly on the double joker. The client
     * writes it in the same batch as the submission, naming the race in
     * jollyRaceId:
     * - spend (-1): the race is added and the submission has mainJolly2;
     * - refund (+1): the race is removed and the submission no longer has
     *   mainJolly2. A refund is possible only once per jolly spent.
     */
    function validJollyChange() {
      let before = resource.data.get('jolly2Races', {}).keys().toSet();
      let after = request.resource.data.get('jolly2Races', {}).keys().toSet();
      let raceId = request.resource.data.get('jollyRaceId', '');
      let delta = request.resource.data.get('jolly', 0) - resource.data.get('jolly', 0);
      let sub = getAfter(/databases/$(database)/documents/races/$(raceId)/submissions/$(request.auth.uid)).data;
      return request.resource.data.jolly is int
        && request.resource.data.jolly >= 0
        && ((delta == -1
              && after.difference(before) == [raceId].toSet()
              && before.difference(after).size() == 0
              && sub.get('mainJolly2', null) != null)
            || (delta == 1
              && before.difference(after) == [raceId].toSet()
              && after.difference(before).size() == 0
              && sub.get('mainJolly2', null) == null));
    }

    /* ===================== GARE (RACES) ==================================
     * Collezione: /races/{raceId}
     * Dati gara: nome, date, risultati ufficiali
     * ==================================================================== */
    match /races/{raceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();

      /* ================= FORMAZIONI (SUBMISSIONS) ========================
       * Subcollection: /races/{raceId}/submissions/{userId}
       * Formazioni dei giocatori per ogni gara
       * =================================================================== */
      match /submissions/{userId} {
        allow read: if isAuthenticated();
        allow create, update: if isAdmin()
          || (isOwner(userId) && validOwnSubmission(raceId, userId));
        allow delete: if isAdmin();
      }
    }

    /* ===================== CAMPIONATO (CHAMPIONSHIP) =====================
     * Collezione: /championship/{docId}
     * Risultati finali campionato
     * ==================================================================== */
    match /championship/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    /* ===================== CONFIGURAZIONE (CONFIG) =======================
     * Collezione: /config/{docId}
     * Configurazioni globali (es. config/championship con deadlineOverride)
     * Lettura per utenti autenticati, scrittura solo admin
     * ==================================================================== */
    match /config/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    /* ===================== PILOTI E TEAM =================================
     * Collezioni: /drivers/{driverId}, /teams/{teamId}
     * Piloti e team usati in formazioni e risultati (gestiti dall'admin,
     * aggiornati dalla sincronizzazione con le API via Admin SDK)
     * Lettura per utenti autenticati, scrittura solo admin
     * ==================================================================== */
    match /drivers/{driverId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    /* ===================== BACKUP DATABASE ================================
     * Collezione: /backups/{backupId}
     * Backup completi del database
     * ==================================================================== */
    match /backups/{backupId} {
      allow read, write: if isAdmin();
    }

    /* ===================== STORICO CLASSIFICA =============================
     * Collezione: /rankingHistory/{snapshotId}
     * Snapshot storici della classifica
     * ==================================================================== */
    match /rankingHistory/{snapshotId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    /* ===================== NOTIFICHE PUSH ================================
     * Collezione: /notificationsSent/{docId}
     * Deduplicazione notifiche push (solo Cloud Functions / Admin SDK)
     * ==================================================================== */
    match /notificationsSent/{docId} {
      allow read, write: if false;
      // Only Cloud Functions (Admin SDK) can read/write this collection
    }

    /* ===================== FALLBACK ======================================
     * Blocca accesso a qualsiasi altra collezione non definita sopra
     * ==================================================================== */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
